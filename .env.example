# Twitch channel to watch
TWITCH_CHANNEL=

# One OAuth token per viewer account, comma-separated
# Get each token at https://twitchtokengenerator.com (scopes: chat:read, chat:edit)
TWITCH_TOKENS=token_account1,token_account2,token_account3

# Optional: your streamer account OAuth token — only needed for private/sub-only streams.
# Public streams work without this. Get from twitchtokengenerator.com (scope: user:read:email)
TWITCH_STREAMER_TOKEN=

# OpenRouter API key — sign up free at https://openrouter.ai
OPENROUTER_API_KEY=nil
# Primary model (free). Swap for any OpenRouter model if you want better quality.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Fallback model — used automatically if the primary fails or is rate-limited
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# How many viewer personas to simulate (default: 3)
VIEWER_COUNT=3

# --- Twitch app credentials ---
# Register at https://dev.twitch.tv/console → copy Client ID and Client Secret
# Used for stream info (title/category) via Client Credentials — no user login needed
# All reward IDs are auto-discovered by title match on startup — leave blank to auto-detect.
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TTS_REWARD_ID=         # matched by: title contains "text" + "speech"
HIGHLIGHT_REWARD_ID=   # matched by: title contains "highlight"
SUB_REWARD_ID=         # matched by: title contains "sub" + "random"/"unlock"

# How often TTS fires in seconds (default: random between 3m and 8m)
TTS_MIN_INTERVAL=180
TTS_MAX_INTERVAL=480
